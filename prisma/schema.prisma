generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model User {
  id String @id @default(uuid())
  email String @unique
  name String
  passwordHash String
  profileVersion Int @default(0)
  createdAt DateTime @default(now())
  sessions Session[]
  drafts ProfileDraft[]
  profiles Profile[]
  missions Mission[]
  resumes ApprovedResume[]
  imports ProfileImport[]
  profileThreads ProfileThread[]
  careerMemories CareerMemory[]
  wordings ResumeWording[]
  scoutSetting ScoutSetting?
  scoutSweeps ScoutSweep[]
  trackedJobs TrackedJob[]
  traceSpans TraceSpan[]
  applications Application[]
  coachReviews CoachReview[]
}
model Session {
  id String @id @default(uuid())
  tokenHash String @unique
  csrf String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}
model ProfileDraft {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  baseVersion Int
  data Json
  facts Json
  status String @default("DRAFT")
  createdAt DateTime @default(now())
}
model Profile {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  version Int
  data Json
  facts Json
  approvedAt DateTime @default(now())
  missions Mission[]
  @@unique([userId, version])
}
model Mission {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  profileId String
  profile Profile @relation(fields: [profileId], references: [id])
  goal String
  status String @default("QUEUED")
  mode String
  data Json
  events Json
  error String?
  leaseToken String?
  leaseExpiresAt DateTime?
  pendingDecision Json?
  // The long-lived application this run works on; a plain column so runs outlive edits to it.
  applicationId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resumes ApprovedResume[]
  @@index([userId, createdAt])
  @@index([status])
  @@index([applicationId])
}
// One role the user is pursuing, kept across runs and profile versions. Runs (Mission rows) point
// here through applicationId; the same role found twice (same fingerprint) is one application.
model Application {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String
  job Json
  source String
  status String @default("saved")
  history Json
  notes String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, fingerprint])
  @@index([userId, updatedAt])
}
// Workspace-level Career Coach advice, kept per profile version so it outlives any one run.
model CoachReview {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId String
  mode String
  analysis Json
  calls Int @default(0)
  inputTokens Int @default(0)
  outputTokens Int @default(0)
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
model ApprovedResume {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  missionId String
  mission Mission @relation(fields: [missionId], references: [id])
  draftHash String @unique
  content Json
  approvedAt DateTime @default(now())
}

model ProfileImport {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename String
  mime String
  file Bytes
  status String @default("EXTRACTED")
  pages Json
  proposed Json
  events Json
  error String?
  calls Int @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model ProfileThread {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String
  messages Json
  proposals Json
  workingForm Json
  profileVersion Int
  revision Int @default(0)
  busyToken String?
  busyUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, updatedAt])
}

model CareerMemory {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind String
  title String
  text String
  star Json
  source Json
  status String @default("DRAFT")
  recordId String?
  missionId String?
  supersedesId String?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, status])
}

model ResumeWording {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId String
  factId String
  sourceHash String
  before String
  after String
  reason String
  status String @default("PENDING")
  model String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, resumeId])
}

model ScoutSetting {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled Boolean @default(false)
  topK Int @default(3)
  minScore Int @default(50)
  search Json
  updatedAt DateTime @updatedAt
}

model ScoutSweep {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  status String @default("QUEUED")
  trigger String
  mode String
  data Json
  calls Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, createdAt])
}

model TrackedJob {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String
  sweepId String?
  record Json
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  @@unique([userId, fingerprint])
  @@index([userId, firstSeenAt])
}

// One row per model call. Mission and sweep ids are plain columns so spans outlive either.
model TraceSpan {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId String?
  sweepId String?
  agent String
  role String
  model String
  mode String
  startedAt DateTime
  durationMs Int
  attempts Int
  inputTokens Int
  outputTokens Int
  status String
  error String?
  createdAt DateTime @default(now())
  @@index([missionId, startedAt])
  @@index([sweepId, startedAt])
}
