generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model User {
  id String @id @default(uuid())
  email String @unique
  name String
  passwordHash String
  profileVersion Int @default(0)
  createdAt DateTime @default(now())
  sessions Session[]
  drafts ProfileDraft[]
  profiles Profile[]
  missions Mission[]
  resumes ApprovedResume[]
  imports ProfileImport[]
  profileThreads ProfileThread[]
  careerMemories CareerMemory[]
  wordings ResumeWording[]
}
model Session {
  id String @id @default(uuid())
  tokenHash String @unique
  csrf String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}
model ProfileDraft {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  baseVersion Int
  data Json
  facts Json
  status String @default("DRAFT")
  createdAt DateTime @default(now())
}
model Profile {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  version Int
  data Json
  facts Json
  approvedAt DateTime @default(now())
  missions Mission[]
  @@unique([userId, version])
}
model Mission {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  profileId String
  profile Profile @relation(fields: [profileId], references: [id])
  goal String
  status String @default("QUEUED")
  mode String
  data Json
  events Json
  error String?
  leaseToken String?
  leaseExpiresAt DateTime?
  pendingDecision Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resumes ApprovedResume[]
  @@index([userId, createdAt])
  @@index([status])
}
model ApprovedResume {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  missionId String
  mission Mission @relation(fields: [missionId], references: [id])
  draftHash String @unique
  content Json
  approvedAt DateTime @default(now())
}

model ProfileImport {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename String
  mime String
  file Bytes
  status String @default("EXTRACTED")
  pages Json
  proposed Json
  events Json
  error String?
  calls Int @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model ProfileThread {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String
  messages Json
  proposals Json
  workingForm Json
  profileVersion Int
  revision Int @default(0)
  busyToken String?
  busyUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, updatedAt])
}

model CareerMemory {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind String
  title String
  text String
  star Json
  source Json
  status String @default("DRAFT")
  recordId String?
  missionId String?
  supersedesId String?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, status])
}

model ResumeWording {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId String
  factId String
  sourceHash String
  before String
  after String
  reason String
  status String @default("PENDING")
  model String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, resumeId])
}
