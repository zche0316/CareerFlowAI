{
  "name": "careerflow-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "worker": "tsx apps/api/src/worker.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "start": "tsx apps/api/src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/generate-client.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run test:matching && npm test && npm run build",
    "test:matching": "node --test packages/matching/original.test.js",
    "postinstall": "node scripts/generate-client.mjs",
    "start:local": "node scripts/local-run.mjs",
    "verify:local": "node scripts/local-run.mjs --verify",
    "package:source": "python3 scripts/package-source.py"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "prisma": "7.9.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@langchain/langgraph": "1.5.1",
    "@langchain/langgraph-checkpoint-postgres": "1.1.0",
    "@napi-rs/canvas": "1.0.13",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "docx": "9.15.0",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "image-size": "2.0.4",
    "lucide-react": "1.59.0",
    "openai": "7.36.0",
    "pdfjs-dist": "6.4.299",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  }
}
