DATABASE_URL=postgresql://careerflow:careerflow@127.0.0.1:55432/careerflow
PORT=8787
APP_ORIGIN=http://localhost:8787
# Start offline without credentials. Set to openai for real model inference.
# "openai" means an OpenAI-compatible protocol; the default team provider is Groq.
PROVIDER_MODE=fixture

# Team default: Groq through its OpenAI-compatible API.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Paste your GROQ key here in your private .env; do not commit or share it.
OPENAI_API_KEY=
# Production baseline on Groq. Use exactly one active OPENAI_MODEL line.
OPENAI_MODEL=openai/gpt-oss-120b
# Optional Groq preview model for comparison (same Groq key and base URL):
# OPENAI_MODEL=qwen/qwen3.8-27b
# DEEPSEEK_API_KEY is an alternative only with a matching DeepSeek URL/model.
DEEPSEEK_API_KEY=

# Optional native OpenAI override.
# When OPENAI_NATIVE_API_KEY is non-empty, ALL text, light and vision routes use
# this section instead of the Groq-compatible settings above. This lets each
# teammate keep Groq while another teammate opts into native OpenAI privately.
# Recommended native allocation:
# - TEXT: mission orchestration, career analysis, job fit, resume and feedback.
# - LIGHT: Profile Builder conversation, organisation and wording suggestions.
# - VISION: user-authorised resume-page recognition and structured extraction.
# gpt-6-luna supports the text, image, JSON and required-tool paths used here.
# Keep the three variables separate so each role can be evaluated independently later.
# Never commit a real key. Restart the app and worker after changing providers.
OPENAI_NATIVE_API_KEY=
OPENAI_NATIVE_BASE_URL=https://api.openai.com/v1
OPENAI_NATIVE_TEXT_MODEL=gpt-6-luna
OPENAI_NATIVE_LIGHT_MODEL=gpt-6-luna
OPENAI_NATIVE_VISION_MODEL=gpt-6-luna

PROVIDER_TIMEOUT_MS=25000
PROFILE_TIMEOUT_MS=60000
ENABLE_DEMO_LOGIN=true
# Set to false when running `npm run worker` separately.
EMBEDDED_WORKER=true

# Experimental: local semantic suggestions in the memory search only.
# Requires Python with torch/transformers and a locally cached multilingual-e5-small model.
# The application never downloads model weights; missing dependencies fall back to keyword search.
ENABLE_LOCAL_SEMANTIC_SEARCH=false
# SEMANTIC_PYTHON=python3

# Current implementation: official employer/Greenhouse boards need no API key.
# Australia is the current default; country/location can be selected per mission.
JOB_SOURCE=auto

# Automatic search includes Tavily discovery when configured, plus official boards
# and Adzuna when its credentials are available. Use fixtures only for explicit offline runs.
# One basic search returns up to five links; only official API-confirmed jobs are used.
# Set api_key with your private key; keyless is an explicit limited-access option.
TAVILY_ACCESS_MODE=api_key
TAVILY_API_KEY=

# Edit your existing .env; do NOT copy this file over a populated .env.
# Restart the app (and any separate worker) after changing .env.
# Existing missions retain their mode; create a NEW mission to test live AI.

# Groq-compatible fallback allocation when OPENAI_NATIVE_API_KEY is empty:
# - gpt-oss-120b handles text, agent tools and evidence-sensitive profile work.
# - qwen3.8-27b handles explicitly consented visual resume recognition.
# These variables are ignored while OPENAI_NATIVE_API_KEY is set.
# Keep LIGHT_TEXT_MODEL blank to reuse 120B; use gpt-oss-20b only in a measured
# latency/cost experiment because Profile Builder extraction is evidence-sensitive.
TEXT_MODEL=
LIGHT_TEXT_MODEL=
# Vision is used only after explicit import consent. Same Groq key works for both.
VISION_MODEL=qwen/qwen3.8-27b
VISION_BASE_URL=https://api.groq.com/openai/v1
# Leave blank to reuse OPENAI_API_KEY (only when it is a Groq key).
VISION_API_KEY=
