DATABASE_URL=postgresql://careerflow:careerflow@127.0.0.1:55432/careerflow
PORT=8787
APP_ORIGIN=http://localhost:8787
PROVIDER_MODE=fixture
# Leave blank for OpenAI; Groq: https://api.groq.com/openai/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
DEEPSEEK_API_KEY=
PROVIDER_TIMEOUT_MS=25000
ENABLE_DEMO_LOGIN=true
# Set to false when running `npm run worker` separately.
EMBEDDED_WORKER=true

# Optional real country-wide job search
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Recruitment defaults; use adzuna only after configuring its separate credentials
JOB_SOURCE=employers
ADZUNA_COUNTRY=au
