DATABASE_URL=postgresql://careerflow:careerflow@127.0.0.1:55432/careerflow
PORT=8787
APP_ORIGIN=http://localhost:8787
# Start offline without credentials. Set to openai for REAL Groq inference.
# "openai" means the compatible API protocol, not the model's vendor.
PROVIDER_MODE=fixture
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Paste your GROQ key here in your private .env; do not commit or share it.
OPENAI_API_KEY=
# Production baseline on Groq. Use exactly one active OPENAI_MODEL line.
OPENAI_MODEL=openai/gpt-oss-120b
# Optional Groq preview model for comparison (same Groq key and base URL):
# OPENAI_MODEL=qwen/qwen3.8-27b
# For direct OpenAI service, change the key/model and leave OPENAI_BASE_URL blank.
# DEEPSEEK_API_KEY is an alternative only with a matching DeepSeek URL/model.
DEEPSEEK_API_KEY=
PROVIDER_TIMEOUT_MS=25000
ENABLE_DEMO_LOGIN=true
# Set to false when running `npm run worker` separately.
EMBEDDED_WORKER=true

# Current implementation: official employer/Greenhouse boards need no API key.
# Australia is the current default; country/location can be selected per mission.
JOB_SOURCE=employers

# Tavily discovery: choose it in the mission form, or set JOB_SOURCE=tavily.
# One basic search returns up to five links; only official API-confirmed jobs are used.
# Set api_key with your private key; keyless is an explicit limited-access option.
TAVILY_ACCESS_MODE=api_key
TAVILY_API_KEY=

# Edit your existing .env; do NOT copy this file over a populated .env.
# Restart the app (and any separate worker) after changing .env.
# Existing missions retain their mode; create a NEW mission to test live AI.

# Deterministic router: primary text defaults to OPENAI_MODEL.
# Leave LIGHT_TEXT_MODEL blank to keep 120B; optionally compare openai/gpt-oss-20b.
TEXT_MODEL=
LIGHT_TEXT_MODEL=
# Vision is used only after explicit import consent. Same Groq key works for both.
VISION_MODEL=qwen/qwen3.8-27b
VISION_BASE_URL=https://api.groq.com/openai/v1
# Leave blank to reuse OPENAI_API_KEY (only when it is a Groq key).
VISION_API_KEY=
