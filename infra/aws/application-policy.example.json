{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_WITH_BACKUP_BUCKET",
      "Condition": { "StringLike": { "s3:prefix": "approved-resumes/*" } }
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BACKUP_BUCKET/approved-resumes/*"
    }
  ]
}
